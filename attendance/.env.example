# ---------------------------------------------------------------------------
# Restaurant Attendance — server environment template. PLACEHOLDERS ONLY.
# Copy to .env (never commit it) or set these in your hosting provider.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Public HTTPS address of the dashboard (used for email links + secure cookies)
PUBLIC_BASE_URL=https://attendance.example.com

# Runtime connection: the NON-owner role (row-level security applies). See deploy/db-roles.sql
DATABASE_URL=postgres://att_app:CHANGE_ME@db.example.com:5432/attendance?sslmode=require
# Owner role, used only for migrations (npm run migrate:prod / MIGRATE_ON_START)
MIGRATION_DATABASE_URL=postgres://att_owner:CHANGE_ME@db.example.com:5432/attendance?sslmode=require
APP_DB_ROLE=att_app
DATABASE_SSL=true
MIGRATE_ON_START=true

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Rotation: prepend a new version, keep old ones until templates are re-enrolled: "2:NEW,1:OLD"
TEMPLATE_KEYS=1:REPLACE_WITH_openssl_rand_base64_32

# Allow new restaurants to self-register (set false for a single private restaurant after setup)
SIGNUP_ENABLED=true
RUN_WORKER=true
TRUST_PROXY=true

# Email: smtp | resend | log | disabled
EMAIL_TRANSPORT=resend
EMAIL_FROM=Attendance <attendance@your-domain.com>
RESEND_API_KEY=re_REPLACE_ME
# --- or SMTP ---
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=REPLACE_ME
# SMTP_PASS=REPLACE_ME

DEVICE_OFFLINE_MINUTES=15
